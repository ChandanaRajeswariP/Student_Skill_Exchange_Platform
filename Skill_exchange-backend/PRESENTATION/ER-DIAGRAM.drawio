<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="Actual MySQL ER diagram" id="chandana-mysql"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1370"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Chandana DBMS — Actual MySQL ER Diagram" style="text;html=1;align=center;whiteSpace=wrap;fontSize=28;" vertex="1" parent="1"><mxGeometry x="100" y="25" width="1300" height="50" as="geometry"/></mxCell><mxCell id="subtitle" value="Database: skill_exchange • Source: database/01-schema.sql • PK = primary key; FK = foreign key; UQ = unique" style="text;html=1;align=center;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1"><mxGeometry x="100" y="80" width="1300" height="40" as="geometry"/></mxCell><mxCell id="students" value="&lt;b&gt;STUDENTS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;name&lt;br&gt;UQ email&lt;br&gt;password_hash&lt;br&gt;bio&lt;br&gt;department&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="263" as="geometry"/></mxCell><mxCell id="student_skills" value="&lt;b&gt;STUDENT_SKILLS&lt;/b&gt;&lt;hr&gt;PK, FK student_id&lt;br&gt;PK, FK skill_id&lt;br&gt;PK kind ('offer' / 'learn')&lt;br&gt;level (1–5)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="330" height="176" as="geometry"/></mxCell><mxCell id="skills" value="&lt;b&gt;SKILLS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;UQ name&lt;br&gt;category" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1090" y="140" width="330" height="147" as="geometry"/></mxCell><mxCell id="availability" value="&lt;b&gt;AVAILABILITY&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK student_id&lt;br&gt;day (0–6)&lt;br&gt;start_hour&lt;br&gt;end_hour&lt;br&gt;UQ (student_id, day,&lt;br&gt;start_hour, end_hour)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="330" height="263" as="geometry"/></mxCell><mxCell id="sessions" value="&lt;b&gt;SESSIONS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK teacher_id → students&lt;br&gt;FK learner_id → students&lt;br&gt;FK skill_id&lt;br&gt;starts_at, ends_at&lt;br&gt;status&lt;br&gt;note, created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="530" width="330" height="263" as="geometry"/></mxCell><mxCell id="reviews" value="&lt;b&gt;REVIEWS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK, UQ session_id&lt;br&gt;FK reviewer_id → students&lt;br&gt;rating (1–5)&lt;br&gt;comment&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1090" y="680" width="330" height="234" as="geometry"/></mxCell><mxCell id="session_audit" value="&lt;b&gt;SESSION_AUDIT&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK session_id&lt;br&gt;old_status&lt;br&gt;new_status&lt;br&gt;changed_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="1030" width="330" height="205" as="geometry"/></mxCell><mxCell id="edge0" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="students" target="student_skills" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="identifies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="skills" target="student_skills" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="declares" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" source="students" target="availability" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="teaches (teacher_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.65;entryX=0;entryY=0.25;" edge="1" source="students" target="sessions" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="learns (learner_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.45;" edge="1" source="students" target="sessions" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="covers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" edge="1" source="skills" target="sessions" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" source="sessions" target="reviews" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="writes (reviewer_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" source="students" target="reviews" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="sessions" target="session_audit" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Each child row references one parent. A session has at most one review. STUDENT_SKILLS uses a three-column composite primary key." style="text;html=1;align=center;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1"><mxGeometry x="70" y="1290" width="1360" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>