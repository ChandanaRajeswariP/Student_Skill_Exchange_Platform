MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=skillapp
MYSQL_PASSWORD=change-this-local-password
MYSQL_DATABASE=skill_exchange
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# MongoDB URI is generated into .env by scripts/Start-Mongo.ps1.
# For an existing MongoDB server, set the application connection URI here.
MONGODB_URI=
MONGODB_DATABASE=skill_resources
