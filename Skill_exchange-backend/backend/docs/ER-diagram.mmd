erDiagram
    STUDENTS ||--o{ STUDENT_SKILLS : has
    SKILLS ||--o{ STUDENT_SKILLS : identifies
    STUDENTS ||--o{ AVAILABILITY : declares
    STUDENTS ||--o{ SESSIONS : teaches
    STUDENTS ||--o{ SESSIONS : learns
    SKILLS ||--o{ SESSIONS : covers
    SESSIONS ||--o| REVIEWS : receives
    STUDENTS ||--o{ REVIEWS : writes
    SESSIONS ||--o{ SESSION_AUDIT : records
    STUDENTS {
        bigint id PK
        varchar email UK
        varchar name
        varchar password_hash
        varchar bio
        varchar department
        timestamp created_at
    }
    SKILLS {
        bigint id PK
        varchar name UK
        varchar category
    }
    STUDENT_SKILLS {
        bigint student_id PK,FK
        bigint skill_id PK,FK
        enum kind PK
        tinyint level
    }
    AVAILABILITY {
        bigint id PK
        bigint student_id FK
        tinyint day
        tinyint start_hour
        tinyint end_hour
    }
    SESSIONS {
        bigint id PK
        bigint teacher_id FK
        bigint learner_id FK
        bigint skill_id FK
        datetime starts_at
        datetime ends_at
        enum status
        varchar note
        timestamp created_at
    }
    REVIEWS {
        bigint id PK
        bigint session_id FK,UK
        bigint reviewer_id FK
        tinyint rating
        varchar comment
        timestamp created_at
    }
    SESSION_AUDIT {
        bigint id PK
        bigint session_id FK
        varchar old_status
        varchar new_status
        timestamp changed_at
    }